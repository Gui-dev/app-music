{
	"name": "@app-music/server",
	"version": "1.0.0",
	"private": true,
	"main": "dist/server.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc",
		"start": "node dist/server.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint src/",
		"format": "biome format --write src/",
		"check": "biome check src/"
	},
	"dependencies": {
		"@fastify/cors": "^11.3.0",
		"@fastify/type-provider-zod": "^1.0.0",
		"@tokenizer/token": "^0.3.0",
		"better-sqlite3": "^11.10.0",
		"content-type": "^3.1.0",
		"debug": "^4.4.3",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.0.0",
		"file-type": "18",
		"media-typer": "^2.0.0",
		"music-metadata": "^8.3.0",
		"strtok3": "^10.3.5",
		"token-types": "^6.1.2",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@types/better-sqlite3": "^7.6.0",
		"@types/supertest": "^6.0.0",
		"drizzle-kit": "^0.31.10",
		"supertest": "^7.1.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	}
}
