{
	"$schema": "https://json.schemastore.org/biome",
	"linter": {
		"enabled": true,
		"rules": {
			"suspicious": {
				"noConsole": "off"
			},
			"nursery": {
				"useSortedClasses": "error"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"javascript": {
		"formatter": {
			"semicolons": "asNeeded",
			"quoteStyle": "single"
		}
	}
}
